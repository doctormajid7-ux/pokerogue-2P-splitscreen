<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Aucune permission système demandée : tout le contenu est dans les
         assets et servi par WebViewAssetLoader. Les liens externes s'ouvrent
         dans le navigateur, qui porte sa propre permission. C'est la garantie
         matérielle que la coque solo ne parle jamais au réseau. Seule apparaît
         dans l'APK final `org.pokerogue.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION`,
         injectée par androidx.core : permission propre à l'application
         (protectionLevel=signature), sans effet réseau. -->

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PokeRogue">

        <!-- `orientation`, `screenSize`, `screenLayout` et `smallestScreenSize`
             sont absorbés par l'activité : elle survit à la rotation, donc la
             partie en cours ne redémarre pas (la page n'est plus rechargée) et
             la sauvegarde localStorage n'est pas remise en avant. C'est
             `MainActivity.onConfigurationChanged` qui réapplique le plein
             écran et vérifie que la géométrie vue par la page suit bien la
             WebView. Le mode solo suit le capteur ; la coque 2P est verrouillée
             en portrait. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Coque 2 joueurs : entrée distincte du jeu solo, verrouillée en
             portrait (deux moitiés empilées, celle du haut retournée). Elle
             absorbe aussi les changements de taille (fenêtre partagée, clavier)
             pour ne pas recharger les deux parties. -->
        <activity
            android:name=".TwoPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name_2p"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
